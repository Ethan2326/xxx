# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=AudioAssist Pro
DEBUG=false
SECRET_KEY=your-very-secret-key-change-me-in-production

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://audioassist:audioassist@db:5432/audioassist
DATABASE_URL_SYNC=postgresql://audioassist:audioassist@db:5432/audioassist

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── IA Claude (Anthropic) ───────────────────────────────────────────────────
# Obtenir une clé sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Noah 4 ───────────────────────────────────────────────────────────────────
# Noah 4 nécessite l'agent-pont audioassist-noah-bridge sur le poste local
NOAH4_HOST=localhost
NOAH4_PORT=1337
NOAH4_TIMEOUT=30

# ─── AudioWizard ─────────────────────────────────────────────────────────────
AUDIOWIZARD_URL=https://votre-centre.audiowizard.fr
AUDIOWIZARD_API_KEY=aw-api-key-here

# ─── Cosium ───────────────────────────────────────────────────────────────────
COSIUM_URL=https://votre-centre.cosium.fr
COSIUM_USERNAME=admin
COSIUM_PASSWORD=votre-mot-de-passe

# ─── EDI SFTP / AS2 ──────────────────────────────────────────────────────────
EDI_SFTP_HOST=edi.fabricant.com
EDI_SFTP_PORT=22
EDI_SFTP_USER=audioassist
EDI_SFTP_KEY_PATH=/run/secrets/edi_sftp_key
EDI_SENDER_ID=VOTRE_GLN_OU_CODE
EDI_RECEIVER_ID=GLN_FABRICANT

# ─── SMTP — Envoi emails PEC mutuelles ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_SENDER_NAME=AudioAssist Pro
SMTP_SENDER_EMAIL=votre-email@gmail.com
# BCC automatique sur toutes les PEC envoyées (optionnel)
SMTP_BCC_CENTRE=archive@votre-centre.fr

# ─── LinkedIn Lead Scraper ───────────────────────────────────────────────────
# Choisir le provider : "proxycurl" (recommandé) ou "apify"
LINKEDIN_SCRAPER_PROVIDER=proxycurl

# ProxyCurl — https://nubela.co/proxycurl  (~$0.003/crédit)
PROXYCURL_API_KEY=your-proxycurl-api-key

# Apify (alternative) — https://apify.com  (acteur linkedin-post-scraper)
APIFY_API_TOKEN=your-apify-api-token

# ─── CORS ────────────────────────────────────────────────────────────────────
# Séparer par virgule
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://frontend-1w0c.onrender.com"]
